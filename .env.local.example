# Firebase config for the registration app (project: acm-cbu-open-house)
# Values live in academic-open-house/.env for now — copy them here.
NEXT_PUBLIC_REG_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_REG_FIREBASE_AUTH_DOMAIN=acm-cbu-open-house.firebaseapp.com
NEXT_PUBLIC_REG_FIREBASE_PROJECT_ID=acm-cbu-open-house
NEXT_PUBLIC_REG_FIREBASE_STORAGE_BUCKET=acm-cbu-open-house.firebasestorage.app
NEXT_PUBLIC_REG_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_REG_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_REG_ADMIN_PASSWORD=change-me
