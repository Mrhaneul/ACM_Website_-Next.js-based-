rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    // Officers and team leads. Keep in sync with src/config/site.ts and
    // src/data/teams.ts (src/lib/staff.ts mirrors this for the UI).
    function isStaffEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['andrewwillis771@outlook.com', 'brandon.magana@calbaptist.edu', 'calebjohn.vanrandwyk@calbaptist.edu', 'eli.manning@calbaptist.edu', 'jeremymatthew.freeman@calbaptist.edu', 'williamjames.anklam@calbaptist.edu'];
    }
    function isStaff() {
      return isStaffEmail()
        || (isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'leader']);
    }
    function isEmail(s) { return s is string && s.size() <= 254 && s.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'); }
    function shortStr(s, n) { return s is string && s.size() <= n; }

    // Member profiles: owner can read/write their own; signed-in members can
    // read others (leaderboard); leads/admins can edit anyone.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isStaff();
      allow delete: if isStaff();
    }

    match /projects/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Join form (/join). Anyone can submit; officers and leads read/export
    // from /register/admin.
    match /registrations/{id} {
      allow create: if
        shortStr(request.resource.data.fullName, 160) && request.resource.data.fullName.size() > 0
        && isEmail(request.resource.data.cbuEmail)
        && shortStr(request.resource.data.cbuId, 20)
        && shortStr(request.resource.data.major, 120)
        && shortStr(request.resource.data.classYear, 40)
        && request.resource.data.teams is list && request.resource.data.teams.size() <= 5
        && shortStr(request.resource.data.otherInterest, 2000)
        && shortStr(request.resource.data.missionInterest, 10)
        && shortStr(request.resource.data.aiCoding, 10)
        && shortStr(request.resource.data.techExperience, 20)
        && shortStr(request.resource.data.techExperienceDetail, 2000);
      allow read, update, delete: if isStaff();
    }

    // Contact form. Anyone can submit; only leads/admins can read.
    match /messages/{id} {
      allow create: if
        shortStr(request.resource.data.name, 120) && request.resource.data.name.size() > 0
        && isEmail(request.resource.data.email)
        && shortStr(request.resource.data.subject, 200)
        && shortStr(request.resource.data.message, 5000) && request.resource.data.message.size() >= 10;
      allow read, update, delete: if isStaff();
    }
  }
}
